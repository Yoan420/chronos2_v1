PIT_DELIVERY_ALIASES = (
    "delivery_timestamp",
    "delivery_time",
    "delivery_datetime",
    "value_date",
    "value_datetime",
    "target_timestamp",
    "target_time",
    "timestamp",
    "datetime",
    "date_time",
    "date",
)

PIT_AVAILABILITY_ALIASES = (
    "as_of",
    "asof",
    "snapshot_as_of",
    "snapshot_time",
    "snapshot_timestamp",
    "query_as_of",
    "available_at",
    "availability_timestamp",
    "retrieved_at",
    "ingested_at",
)

PIT_REVISION_ALIASES = (
    "revision",
